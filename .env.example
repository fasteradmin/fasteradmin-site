# n8n webhook endpoints backing the site.
NEXT_PUBLIC_FORM_ENDPOINT=https://jcmt.app.n8n.cloud/webhook/fasteradmin-contact
NEXT_PUBLIC_AVAILABILITY_ENDPOINT=https://jcmt.app.n8n.cloud/webhook/fasteradmin-availability
NEXT_PUBLIC_BOOKING_ENDPOINT=https://jcmt.app.n8n.cloud/webhook/fasteradmin-book

# Shared token the workflows check. NOT a secret: NEXT_PUBLIC_ vars are baked
# into the client bundle and readable by anyone who views source. It only
# raises the cost of drive-by abuse against a discovered webhook URL.
NEXT_PUBLIC_FA_TOKEN=<generate-your-own>

NEXT_PUBLIC_TURNSTILE_SITE_KEY=<your-turnstile-site-key>
